
# Copy to .env and fill in the real values. Do not commit .env.
#
# DB_HOST / DB_PORT are already pinned in docker-compose.yml per the
# deployment spec — only what's below needs filling in here.

DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=cfo_iot

# Must match meter-dashboard's JWT_SECRET exactly — both services decode
# the same tokens, meter-dashboard has no users table of its own.
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_MINUTES=60

MAX_UPLOAD_MB=15

# Stripped from the incoming request path before routing, if present.
# Safe to leave as /iot even if the proxy already strips it (no-op on
# paths that don't start with it). Leave blank if not behind a proxy
# with a base path.
BASE_PATH_PREFIX=/iot

# --- No-login upload key (see app/auth.py get_uploader()) ---------------
# Optional alternative to logging in — a device can send a fixed
# X-Device-Key header on POST /images/upload instead of a JWT. Leave both
# blank to disable this and require a real login for every upload.
# Generate a key with: openssl rand -hex 32
DEVICE_API_KEY=CHANGE_ME
# Must be an existing username (e.g. the "esp32" device account) —
# uploads authenticated via DEVICE_API_KEY are attributed to this user.
DEVICE_API_KEY_USERNAME=esp32

# --- No-login key for the OCR client (see app/auth.py get_ocr_client()) --
# Same idea as DEVICE_API_KEY, but for the external OCR client — a
# separate key on purpose (rotating/revoking the OCR machine's access
# should never affect ESP32 devices, and vice versa). Needs an ADMIN
# account (claims jobs, submits results back). Leave both blank to
# require a real admin login instead. Generate with: openssl rand -hex 32
OCR_CLIENT_KEY=CHANGE_ME
# Must be an existing ADMIN username (e.g. "ocr-service").
OCR_CLIENT_KEY_USERNAME=ocr-service

MAX_OCR_ATTEMPTS=5

# --- Burst upload grouping (see app/grouping.py) -------------------------
# ESP32 sends multiple photos per reading. Server waits this many seconds
# after a burst's first image before finalizing the group into a job —
# adjust based on real device timing (your example bursts landed ~10-20s
# apart). Sweep interval is just the poll frequency, not the wait itself.
IMAGE_GROUP_WINDOW_SECONDS=60
GROUP_SWEEP_INTERVAL_SECONDS=5
# Fast path: a group finalizes into ocr_jobs immediately once it reaches
# this many images — no waiting for the window above. The window is only
# the fallback for groups that never reach this count.
IMAGE_GROUP_SIZE=3
# A capture counts as "on schedule" if its device_timestamp falls within
# this many minutes of any configured slot in that meter's device_config
# (see the "Scheduled vs. test captures" README section). Outside this
# tolerance, the whole group is marked is_test=true and its result goes
# to ocr_meter_test instead of ocr_meter.
SCHEDULE_MATCH_TOLERANCE_MINUTES=5
