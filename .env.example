V
# Real .env for docker-compose.yml (production). Not committed to git.
#
# DB_HOST / DB_PORT / TZ / BASE_PATH_PREFIX are already pinned directly in
# docker-compose.yml — nothing to set for those here.
 
# --- Postgres --------------------------------------------------------------
# TODO: fill in with the real production DB credentials. Not pre-filled
# here on purpose — the values shared in chat earlier are considered
# compromised (see rotation note from earlier), and I don't have new
# legitimate ones to put in their place. Rotate on the DB server first,
# then fill these in.
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=CHANGE_ME
 
# --- JWT ---------------------------------------------------------------
# Freshly generated just now (openssl rand -hex 32) — NOT the value
# pasted in chat earlier. Copy this exact value into meter-dashboard's
# own .env too (JWT_SECRET must match on both sides) when you rotate.
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
 
MAX_UPLOAD_MB=15
 
# --- No-login device/service keys ---------------------------------------
# Also freshly generated — not the values pasted in chat earlier.
DEVICE_API_KEY=
DEVICE_API_KEY_USERNAME=esp32
 
OCR_CLIENT_KEY=
OCR_CLIENT_KEY_USERNAME=
 
MAX_OCR_ATTEMPTS=5
 
# --- Burst upload grouping (see app/grouping.py) -------------------------
# Waits this long after a burst's first image before finalizing the
# group into a job. 30s default — adjust once you know real device
# timing (your example bursts were ~10-20s apart, so 30s leaves margin).
IMAGE_GROUP_WINDOW_SECONDS=60
GROUP_SWEEP_INTERVAL_SECONDS=5
 